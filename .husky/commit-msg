#!/usr/bin/env bash
# Husky invokes hooks with `sh`; re-exec under bash for pipefail / local.
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi
set -euo pipefail

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: missing commit message file" >&2
  exit 1
fi

# Cursor CLI/IDE can append Co-authored-by / Made-with trailers when
# attributeCommitsToAgent is enabled. Reject them so public history stays clean
# even if a local tool re-enables attribution.
if grep -Eiq \
  '^[[:space:]]*(Co-authored-by:[[:space:]]*Cursor\b|Made-with:[[:space:]]*Cursor\b)|cursoragent@cursor.com' \
  "$msg_file"; then
  echo "commit-msg: refusing Cursor attribution trailers in commit message" >&2
  echo "commit-msg: disable attribution in ~/.cursor/cli-config.json (attributeCommitsToAgent / attributePRsToAgent)" >&2
  grep -Ein \
    '^[[:space:]]*(Co-authored-by:[[:space:]]*Cursor\b|Made-with:[[:space:]]*Cursor\b)|cursoragent@cursor.com' \
    "$msg_file" >&2 || true
  exit 1
fi

npx --no -- commitlint --edit "$msg_file"
