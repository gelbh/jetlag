#!/usr/bin/env bash
# Husky invokes hooks with `sh`; re-exec under bash for pipefail / local.
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi
set -euo pipefail

# Conventional Commits for open PR title (skip if no gh / no open PR).
if command -v gh >/dev/null 2>&1; then
  pr_title="$(gh pr view --json title --jq .title 2>/dev/null || true)"
  if [ -n "${pr_title:-}" ]; then
    npm run lint:pr-title -- "$pr_title"
  fi
fi

npm run lint
npm run lint:css
npm run typecheck

# Skip when origin/main is missing or not an ancestor (e.g. after history rewrite).
if git rev-parse --verify origin/main >/dev/null 2>&1 \
  && git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
  npm run test:changed
fi

push_input="$(cat)"

if [ -n "$push_input" ]; then
  printf '%s\n' "$push_input" | while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
      continue
    fi

    range="${remote_sha}..${local_sha}"
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      range="$local_sha"
    fi

    if git diff --name-only $range | grep -qE '^(package\.json|CHANGELOG\.md|src/domain/device/changelog\.ts)$'; then
      npm run release:check || exit 1
    fi
  done
fi
