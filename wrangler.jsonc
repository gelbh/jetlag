{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jetlag",
  "compatibility_date": "2026-09-26",
  "main": "worker/index.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jetlag.gelbhart.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  // Secrets: see worker/README.md (wrangler secret put / .dev.vars). Never commit values.
  // Tunnel allowlist: set real host/project from VITE_SENTRY_DSN before deploy (empty → 403).
  "vars": {
    "SENTRY_TUNNEL_ALLOWED_HOST": "",
    "SENTRY_TUNNEL_ALLOWED_PROJECT_IDS": ""
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // HTML nonce CSP + /api/*; trades asset-first latency for middleware on all routes
    "run_worker_first": true
  }
}
