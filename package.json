{
  "name": "jetlag",
  "private": true,
  "version": "1.12.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "bash scripts/dev/emulator.sh",
    "dev:local": "bash scripts/dev/local.sh",
    "emulators:local": "bash scripts/dev/emulators.sh",
    "wasm:build": "wasm-pack build crates/jetlag-geometry-kernel --target bundler --out-dir pkg --release",
    "build": "node scripts/build/pipeline.mjs",
    "preview": "vite preview",
    "preview:lhci": "node scripts/lighthouse/preview-server.mjs",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "lint:pr-title": "bash scripts/ci/lint-pr-title.sh",
    "doctor": "npx react-doctor@latest",
    "typecheck": "tsc -b --noEmit",
    "flags:sync": "node scripts/flags/sync.mjs",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage --project unit",
    "test:changed": "vitest run --changed origin/main --passWithNoTests --project unit",
    "test:changeset-map": "node --test .changeset/section-map.test.mjs scripts/release/normalize-changelog-sections.test.mjs scripts/release/changelog-release-body.test.mjs scripts/release/create-github-release.test.mjs scripts/build/check-entry-budget.test.mjs scripts/build/seo-build-lib.test.mjs scripts/lighthouse/document-route.test.mjs scripts/lighthouse/runner-summary.test.mjs scripts/lighthouse/runner-class.test.mjs scripts/lighthouse/assert-levels.test.mjs scripts/lib/run-command.test.mjs scripts/geo/fill-pack-core.test.mjs",
    "test:functions": "env -u npm_config_allow_scripts sh -c 'cd functions && npm ci && npm test'",
    "test:emulator": "firebase emulators:exec --project demo-jetlag --only auth,firestore,storage,functions \"npm run test:emulator:vitest\"",
    "test:emulator:vitest": "vitest run --project emulator",
    "test:e2e": "playwright test",
    "test:e2e:gate-smoke": "E2E_GATE_SMOKE=1 playwright test",
    "test:e2e:resilience": "E2E_PREVIEW=1 playwright test --project=resilience",
    "test:perf": "GEOMETRY_PERF=1 vitest run --project unit src/domain/geometry/gameArea/geometryPerf.test.ts src/domain/geometry/kernel/spatialVoronoiPerf.test.ts src/domain/geometry/kernel/nearRegionBatchPerf.test.ts src/domain/geometry/kernel/unionWasmPerf.test.ts --pool=forks --maxWorkers=1",
    "test:lighthouse": "node scripts/lighthouse/run.mjs",
    "deploy": "node scripts/deploy/production.mjs",
    "version": "changeset version && node scripts/release/normalize-changelog-sections.mjs && node scripts/release/sync-changelog-ts.mjs",
    "release": "changeset publish && node scripts/release/create-github-release.mjs",
    "release:check": "node scripts/release/check.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.2.7",
    "@fontsource/source-sans-3": "^5.3.1",
    "@mantine/core": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.5",
    "@tmcw/togeojson": "^7.1.3",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-intersect": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/polygonize": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@xmldom/xmldom": "^0.9.12",
    "circle-union": "^1.0.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "flatbush": "^4.6.2",
    "geoflatbush": "^2.2.1",
    "geokdbush": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "kdbush": "^4.1.0",
    "lru-cache": "^11.5.2",
    "maplibre-gl": "^6.15.0",
    "martinez-polygon-clipping": "^0.9.0",
    "posthog-js": "^1.438.19",
    "posthog-node": "^5.57.0",
    "rbush": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@commitlint/cli": "~21.2.3",
    "@commitlint/config-conventional": "~21.2.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/coverage-v8": "~5.0.5",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.34.0",
    "husky": "^9.1.7",
    "jsdom": "~30.1.3",
    "oxc-transform-react": "0.154.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "~4.3.0",
    "typescript": "~7.0.2",
    "vite": "~8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "~5.0.2",
    "wrangler": "^4.151.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.15",
    "@rolldown/binding-darwin-x64": "1.2.15",
    "@rolldown/binding-linux-x64-gnu": "1.2.15"
  },
  "overrides": {
    "node-fetch": {
      "whatwg-url": "^14.0.0"
    },
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "tmp": "^0.2.6",
    "@hono/node-server": "^2.0.5",
    "js-yaml@3": {
      ".": "3.15.2",
      "argparse": "^2.0.1"
    },
    "js-yaml@4": "4.3.2",
    "undici@7": "7.30.0",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "@grpc/grpc-js": "^1.14.5",
    "fast-uri": "3.1.8",
    "morgan": "1.12.1",
    "basic-ftp": "6.2.3",
    "@puppeteer/browsers": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "workerd@1.20260923.1": true,
    "re2@1.26.1": true,
    "@firebase/util@1.15.3": true,
    "core-js@3.49.0": true
  }
}
