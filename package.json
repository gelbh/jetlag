{
  "name": "jetlag",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "wasm:build": "wasm-pack build crates/jetlag-geometry-kernel --target bundler --out-dir pkg --release",
    "build": "node scripts/run-build.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint --cache --report-needless-disables --report-invalid-scope-disables \"src/**/*.css\" \"public/**/*.css\"",
    "lint:pr-title": "bash scripts/lint-pr-title.sh",
    "typecheck": "tsc -b --noEmit",
    "tokens:build": "node scripts/build-tokens.mjs",
    "flags:sync": "node scripts/sync-region-flags.mjs",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage --project unit",
    "test:changed": "vitest run --changed origin/main --passWithNoTests --project unit",
    "test:changeset-map": "node --test .changeset/section-map.test.mjs scripts/normalize-changelog-sections.test.mjs scripts/changelog-release-body.test.mjs",
    "test:functions": "env -u npm_config_allow_scripts sh -c 'cd functions && npm ci && npm test'",
    "test:emulator": "firebase emulators:exec --project demo-jetlag --only auth,firestore,storage \"npm run test:emulator:vitest\"",
    "test:emulator:vitest": "vitest run --project emulator",
    "test:e2e": "playwright test",
    "test:e2e:gate-smoke": "E2E_GATE_SMOKE=1 playwright test",
    "test:e2e:layout-deep": "playwright test --grep @layout-deep",
    "test:perf": "GEOMETRY_PERF=1 vitest run --project unit src/domain/geometry/gameArea/geometryPerf.test.ts src/domain/geometry/kernel/spatialVoronoiPerf.test.ts src/domain/geometry/kernel/nearRegionBatchPerf.test.ts --pool=forks --maxWorkers=1",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "deploy": "node scripts/deploy-production.mjs",
    "version": "changeset version && node scripts/normalize-changelog-sections.mjs && node scripts/sync-changelog-ts.mjs",
    "release": "changeset publish && node scripts/create-github-release.mjs",
    "release:sync": "node scripts/sync-changelog-ts.mjs && node scripts/release-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.9",
    "@hookform/resolvers": "^5.9.1",
    "@mantine/core": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "10.69.0",
    "@tanstack/react-query": "^5.103.2",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/polygonize": "^7.4.0",
    "@turf/projection": "^7.3.5",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@use-gesture/react": "^10.3.1",
    "@xmldom/xmldom": "^0.9.12",
    "circle-union": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "d3-delaunay": "^6.0.4",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "flatbush": "^4.6.2",
    "geoflatbush": "^2.2.1",
    "geokdbush": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "kdbush": "^4.1.0",
    "lru-cache": "^11.5.2",
    "maplibre-gl": "^6.11.1",
    "martinez-polygon-clipping": "^0.8.1",
    "motion": "^13.4.2",
    "posthog-js": "^1.434.12",
    "rbush": "^4.0.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.2.4",
    "react-hook-form": "^7.88.0",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "terra-draw": "^1.35.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@commitlint/cli": "~21.2.3",
    "@commitlint/config-conventional": "~21.2.0",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@eslint/js": "~10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.2",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-grid-layout": "^2.1.0",
    "@vitejs/plugin-react": "~6.1.1",
    "@vitest/coverage-v8": "~4.1.11",
    "eslint": "~10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "~30.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "style-dictionary": "^5.5.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "~4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.70.1",
    "vite": "~8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.139.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.10",
    "@rolldown/binding-darwin-x64": "1.2.10",
    "@rolldown/binding-linux-x64-gnu": "1.2.10"
  },
  "overrides": {
    "node-fetch": {
      "whatwg-url": "^14.0.0"
    },
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "tmp": "^0.2.6",
    "@hono/node-server": "^2.0.5",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "undici@7": "7.29.0",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "sharp": "0.35.4",
    "fast-uri": "3.1.6",
    "morgan": "1.12.1"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "workerd@1.20260730.1": true,
    "re2@1.26.1": true,
    "@firebase/util@1.15.2": true,
    "core-js@3.49.0": true
  }
}
