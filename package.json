{
  "name": "jetlag",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "env:pull": "doppler secrets download --no-file --format env > .env.local",
    "dev:secrets": "doppler run --config dev -- npm run dev",
    "dev:emulator": "doppler run --config dev_emulator -- npm run dev",
    "wasm:build": "wasm-pack build crates/jetlag-geometry-kernel --target bundler --out-dir pkg --release",
    "build": "node scripts/run-build.mjs",
    "build:secrets": "doppler run --config prd -- npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" \"public/**/*.css\"",
    "lint:pr-title": "bash scripts/lint-pr-title.sh",
    "typecheck": "tsc -b --noEmit",
    "tokens:build": "node scripts/build-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed origin/main --passWithNoTests",
    "test:functions": "env -u npm_config_allow_scripts sh -c 'cd functions && npm ci && npm test'",
    "test:emulator": "firebase emulators:exec --project demo-jetlag --only auth,firestore,storage \"npm run test:emulator:vitest\"",
    "test:emulator:vitest": "vitest run --config vitest.emulator.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "E2E_SMOKE=1 playwright test",
    "test:e2e:gate-smoke": "E2E_GATE_SMOKE=1 playwright test",
    "test:e2e:layout-deep": "playwright test --grep @layout-deep",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "GEOMETRY_PERF=1 vitest run src/domain/geometry/gameArea/geometryPerf.test.ts src/domain/geometry/kernel/spatialVoronoiPerf.test.ts src/domain/geometry/kernel/nearRegionBatchPerf.test.ts --pool=forks --maxWorkers=1",
    "test:geometry-gates": "node scripts/run-geometry-gates.mjs",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "audit:overpass": "RUN_OVERPASS_AUDIT=1 vitest run src/services/core/overpassAudit.integration.test.ts",
    "emulators:start": "firebase emulators:start --project demo-jetlag --only auth,firestore,storage,functions",
    "deploy": "node scripts/deploy-production.mjs",
    "deploy:worker": "npm run build && wrangler deploy",
    "preview:worker": "npm run build && wrangler dev",
    "cf-typegen": "wrangler types",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-changelog-ts.mjs",
    "release:sync": "node scripts/sync-changelog-ts.mjs && node scripts/release-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@fontsource/barlow-semi-condensed": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.9",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/capacitor": "^4.3.0",
    "@sentry/react": "10.69.0",
    "@tanstack/react-query": "^5.102.8",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/polygonize": "^7.4.0",
    "@turf/projection": "^7.3.5",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@use-gesture/react": "^10.3.1",
    "@xmldom/xmldom": "^0.9.12",
    "circle-union": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "d3-delaunay": "^6.0.4",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "flatbush": "^4.6.2",
    "geoflatbush": "^2.2.1",
    "geokdbush": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jetlag-live-activity": "file:plugins/jetlag-live-activity",
    "jszip": "^3.10.2",
    "kdbush": "^4.1.0",
    "lru-cache": "^11.5.2",
    "maplibre-gl": "^6.4.1",
    "martinez-polygon-clipping": "^0.8.1",
    "motion": "^13.1.0",
    "posthog-js": "^1.429.3",
    "rbush": "^4.0.1",
    "react": "^19.2.6",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.6",
    "react-grid-layout": "^2.2.4",
    "react-hook-form": "^7.87.0",
    "react-map-gl": "^8.1.2",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "terra-draw": "^1.32.2",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.1",
    "@changesets/cli": "^3.0.2",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@commitlint/cli": "~21.2.2",
    "@commitlint/config-conventional": "~21.2.0",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@eslint/js": "~10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.5.1",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-grid-layout": "^2.1.0",
    "@vitejs/plugin-react": "~6.1.1",
    "@vitest/coverage-v8": "~4.1.11",
    "eslint": "~10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.30.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "~30.0.1",
    "playwright": "^1.62.1",
    "style-dictionary": "^5.5.3",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "~4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.70.0",
    "vite": "~8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.131.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.8",
    "@rolldown/binding-darwin-x64": "1.2.8",
    "@rolldown/binding-linux-x64-gnu": "1.2.8"
  },
  "overrides": {
    "node-fetch": {
      "whatwg-url": "^14.0.0"
    },
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "tmp": "^0.2.6",
    "@hono/node-server": "^2.0.5",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "undici@7": "7.29.0",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "sharp": "0.35.4",
    "fast-uri": "3.1.6",
    "morgan": "1.12.1"
  },
  "allowScripts": {
    "@sentry/capacitor@4.2.0": true,
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "workerd@1.20260730.1": true,
    "re2@1.26.1": true,
    "@firebase/util@1.15.2": true,
    "core-js@3.49.0": true
  }
}
